{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": ".output/public",
  "ignoreCommand": "exit 1",
  "rewrites": [
    {
      "source": "/:path((?!_nuxt/).*)",
      "destination": "/index.html"
    }
  ]
}
