{
  "name": "@finapp/app",
  "type": "module",
  "version": "8.3.0-beta.211",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "nuxt generate",
    "check:deps": "node scripts/check-single-reka-ui.mjs",
    "dev": "nuxt dev --port=3050 --public --dotenv=.env.cloud",
    "dev:cloud": "nuxt dev --port=3050 --public --dotenv=.env.cloud",
    "dev:local": "nuxt dev --port=3050 --public --dotenv=.env.local",
    "dev:production": "nuxt dev --port=3050 --public --dotenv=.env.production",
    "dev:review": "VITE_POWERSYNC_SINGLE_TAB=1 nuxt dev --port=3050 --public --dotenv=.env.local",
    "preview": "nuxt preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:smoke": "node scripts/storybook-smoke.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=demo",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:offline": "playwright test --config=playwright.offline.config.ts",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "test:watch": "vitest",
    "typecheck": "nuxi typecheck"
  },
  "dependencies": {
    "@date-fns/utc": "^2.1.1",
    "@formkit/drag-and-drop": "^0.6.1",
    "@iconify-json/mdi": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@pinia/nuxt": "^1.0.2",
    "@powersync/common": "^2.3.0",
    "@powersync/web": "^2.4.1",
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vue/devtools-api": "^8.2.1",
    "echarts": "^6.1.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "localforage": "^1.10.0",
    "motion-v": "^2.4.4",
    "pinia": "^4.0.3",
    "reka-ui": "2.10.4",
    "swiper": "^14.2.0",
    "vaul-vue": "^0.4.1",
    "vite": "^8.3.1",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.0"
  },
  "devDependencies": {
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/lucide": "^1.2.136",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/mcp": "^0.0.82",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/vue3-vite": "^10.6.0",
    "@types/node": "^26.6.2",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "defu": "^6.1.7",
    "es-toolkit": "^1.52.0",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-i18n": "^11.4.12",
    "vue-tsc": "^3.3.11",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zod": "^4.6.5"
  }
}
