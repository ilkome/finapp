{
  "name": "finapp",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "description": "Finapp helps you easily track and manage personal finances",
  "author": "Ilya Komichev @ilkome",
  "license": "MIT",
  "homepage": "https://ilko.me",
  "repository": "ilkome/finapp",
  "engines": {
    "node": ">=v24.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:app": "pnpm --filter @finapp/app build",
    "build:docs": "pnpm --filter @finapp/docs build",
    "dev": "pnpm --filter @finapp/app dev",
    "dev:all": "pnpm --parallel --filter @finapp/app --filter @finapp/docs dev",
    "dev:cloud": "pnpm --filter @finapp/app dev:cloud",
    "dev:docs": "pnpm --filter @finapp/docs dev",
    "dev:local": "pnpm --filter @finapp/app dev:local",
    "dev:production": "pnpm --filter @finapp/app dev:production",
    "lint": "eslint .",
    "lint:app": "eslint app",
    "lint:docs": "eslint docs",
    "lint:fix": "eslint . --fix",
    "preview": "pnpm --filter @finapp/app preview",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter @finapp/app test:watch",
    "test:coverage": "pnpm --filter @finapp/app test:coverage",
    "test:e2e": "pnpm --filter @finapp/app test:e2e",
    "test:e2e:install": "pnpm --filter @finapp/app test:e2e:install",
    "test:e2e:prod": "pnpm --filter @finapp/app test:e2e:prod",
    "test:e2e:ui": "pnpm --filter @finapp/app test:e2e:ui",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @finapp/app check:deps"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nuxt/eslint-config": "^1.16.0",
    "eslint": "^10.5.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-perfectionist": "^5.9.1",
    "eslint-plugin-tailwindcss": "4.2.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  }
}
